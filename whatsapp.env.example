# =============================================================================
# OpenWA Gateway — PRODUCTION env (WhatsApp)
# =============================================================================
# Copy to `.env` on the gateway host and fill in. This is the curated set that
# matters for a production WhatsApp deployment feeding the BoulderSoft backend.
# The full option list lives in .env.example; this file is the "what you must
# set for prod" subset.
#
# TWO HARD RULES:
#   1. API_MASTER_KEY here MUST equal OPENWA_API_KEY in the backend env, or every
#      gateway call returns 401.
#   2. The session/auth directory (SESSION_DATA_PATH / BAILEYS_AUTH_DIR) MUST be a
#      PERSISTENT volume. If it's wiped on deploy, every restart forces users to
#      re-scan the WhatsApp QR.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3130                       # listen port; the backend's OPENWA_BASE_URL points here
LOG_LEVEL=info
AUTO_START_SESSIONS=true            # resume linked sessions on boot (no re-scan)

# Public URL of THIS gateway (startup banner / external links). Terminate TLS at
# a reverse proxy in front — the API key travels in cleartext over plain HTTP.
BASE_URL=https://gateway.yourdomain.com

# CORS: "*" is REFUSED in production. Set explicit origin(s).
CORS_ORIGINS=https://dashboard.yourdomain.com

# If behind a reverse proxy AND using per-key IP allowlists, trust its address so
# X-Forwarded-For resolves the real client IP. Leave unset otherwise.
# TRUSTED_PROXIES=172.18.0.0/16

# ── API security ─────────────────────────────────────────────────────────────
# The key the BoulderSoft backend sends as `X-API-Key`. Generate a strong value:
#   openssl rand -hex 32
# MUST match backend OPENWA_API_KEY.
API_MASTER_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Engine ───────────────────────────────────────────────────────────────────
# whatsapp-web.js (Chromium) or baileys (WebSocket, no Chromium).
# The leave-group readOnly flag is supported on BOTH engines.
ENGINE_TYPE=whatsapp-web.js

# whatsapp-web.js — session dir + browser. SESSION_DATA_PATH must be persistent.
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
# Required in Docker / Linux hosts without a bundled Chromium:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# baileys — auth dir (used only when ENGINE_TYPE=baileys). Must be persistent.
# BAILEYS_AUTH_DIR=./data/baileys
# BAILEYS_SYNC_FULL_HISTORY=false

# Resolve @lid privacy ids to phone numbers on inbound (adds a cached lookup).
# The on-demand /contacts/:id/phone endpoint works regardless of this flag.
# RESOLVE_LID_TO_PHONE=true

# ── Storage ──────────────────────────────────────────────────────────────────
# Prod should NOT use local disk. Point at S3/R2 (or a persistent volume for local).
STORAGE_TYPE=s3
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=openwa
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local fallback (only if STORAGE_TYPE=local) — must be a persistent volume:
# STORAGE_LOCAL_PATH=./data/media

# ── Webhooks (gateway → backend) ─────────────────────────────────────────────
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_SSRF_PROTECT=true

# ── Database ─────────────────────────────────────────────────────────────────
# sqlite is fine for a single instance (keep the file on a persistent volume).
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=true
# For HA / Postgres instead:
# DATABASE_TYPE=postgres
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=openwa
# DATABASE_USERNAME=openwa
# DATABASE_PASSWORD=            # strong, no placeholder — prod refuses to boot otherwise
# DATABASE_SSL=true
# DATABASE_SYNCHRONIZE=false

# ── Redis / queue (optional) ─────────────────────────────────────────────────
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false
